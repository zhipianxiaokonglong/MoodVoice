# ---------------------------------------------------------------------------
# MoodVoice / 情感语音输出层 — 本地配置模板
#
# 使用方法:
#   1. 复制本文件为 .env（.env 已被 .gitignore 忽略，绝不会提交）
#   2. 只填写你实际要使用的厂商密钥；留空表示不启用该厂商
#   3. 重启服务后，在 Demo 的“语音厂商”下拉框中选择对应厂商
#
# 安全约定:
#   - 密钥只从此文件/系统环境变量读取，不写入日志、不进入 API 响应
#   - 本文件中的值都是占位符，不是真实密钥
#   - 不要把 .env 发给任何人，也不要提交到 Git
# ---------------------------------------------------------------------------

# 默认厂商: auto | edge | openai | elevenlabs | azure | minimax | local
# auto 会按 config/app.yaml 的 auto_order 选择第一个已就绪的厂商。
# 没有配置任何密钥时，edge 仍可直接使用（无需账号）。
EMOTION_TTS_PROVIDER=auto

# 可选：显式降级链（逗号分隔）。默认留空 => 厂商失败直接降级为纯文本。
# 只有明确列在这里的厂商才会收到文本，避免意外外发。
# 示例: EMOTION_TTS_FALLBACK_PROVIDERS=local
EMOTION_TTS_FALLBACK_PROVIDERS=

# 本地数据目录（音频缓存、SQLite 记录）。默认 .data/
# EMOTION_TTS_DATA_DIR=.data

# 服务地址（默认只监听本机，避免把带 BYOK 的接口暴露到局域网）
EMOTION_TTS_HOST=127.0.0.1
EMOTION_TTS_PORT=8765

# 仅当通过反向代理/局域网域名访问时填写，逗号分隔。
# 例如：http://192.168.1.20:8765,https://voice.example.com
# 保持为空时只允许 127.0.0.1/localhost 同源访问。
EMOTION_TTS_ALLOWED_ORIGINS=

# ---------------------------- 国际厂商 ----------------------------
# OpenAI TTS: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# 可选，兼容自建网关；默认 https://api.openai.com/v1
OPENAI_BASE_URL=

# ElevenLabs: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# 在 ElevenLabs 控制台复制 Voice ID，填入 config/app.yaml 的 providers.elevenlabs.voice_id
# （Voice ID 不是密钥，但仍建议只放本地配置）

# Azure Neural TTS: https://portal.azure.com/ -> Speech resource -> Keys and Endpoint
AZURE_SPEECH_KEY=
# 例如 eastasia / eastus / westus2
AZURE_SPEECH_REGION=

# ---------------------------- 国内厂商 ----------------------------
# MiniMax 海螺语音: https://platform.minimaxi.com/
MINIMAX_API_KEY=
# MiniMax 控制台的 GroupId（不是密钥，但属于账户信息）
MINIMAX_GROUP_ID=
# 可覆盖接口地址，国际站示例: https://api.minimax.io/v1/t2a_v2
MINIMAX_BASE_URL=

# ---------------------------- 本地部署 ----------------------------
# 任何接受“POST JSON -> 音频二进制”的本地服务，例如你自己封装的
# GPT-SoVITS / CosyVoice / F5-TTS。协议见 docs/PROVIDERS.md。
LOCAL_TTS_URL=
# 若本地服务开启了 Bearer 鉴权，可在此填写；纯本机服务通常留空
LOCAL_TTS_API_KEY=
